# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Distribution / packaging ──────────────────────────────
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# ── Virtual environments ──────────────────────────────────
.venv/
venv/
env/
ENV/
.env

# ── Tests & coverage ──────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Development tools ─────────────────────────────────────
.mypy_cache/
.ruff_cache/
*.DS_Store
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ── PyInstaller (executable packaging) ───────────────────
*.spec
!celeste.spec
/dist_exe/

# ── User data ─────────────────────────────────────────────
# Preferences and favourites live in ~/.celeste (settings.py); the copies left
# here by versions 4.1 and earlier are taken over, then ignored.
/settings.json
/favorites.json

# ── Claude Code ───────────────────────────────────────────
.claude/

# ── Generated files ───────────────────────────────────────
# JPL/IMCCE ephemerides (downloaded on demand) and exported PDFs
*.bsp
/*.pdf

# ── JPL DE440 ephemeris (32 MB, downloaded at the first launch) ──
data/*.bsp
.history/
/Celeste_App/
