# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Distribution / packaging ──────────────────────────────
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# ── Environnements virtuels ───────────────────────────────
.venv/
venv/
env/
ENV/
.env

# ── Tests & couverture ────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Outils de développement ───────────────────────────────
.mypy_cache/
.ruff_cache/
*.DS_Store
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ── PyInstaller (packaging exécutable) ───────────────────
*.spec
!celeste.spec
/dist_exe/

# ── Données utilisateur ───────────────────────────────────
