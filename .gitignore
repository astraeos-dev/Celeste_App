# laissées ici par les versions ≤ 4.1 sont reprises puis ignorées.
/settings.json
/favorites.json

# ── Claude Code ───────────────────────────────────────────
.claude/

# ── Fichiers générés ──────────────────────────────────────
# Éphémérides JPL/IMCCE (téléchargées à la demande) et PDF exportés
*.bsp
/*.pdf

# ── Éphéméride JPL DE440 (32 Mo, téléchargée au premier lancement) ──
data/*.bsp
